<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mediascanner.ui.MainController"
            prefWidth="1000" prefHeight="700">

    <top>
        <VBox styleClass="header-bar">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label text="MediaScanner" styleClass="app-title"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="16">
                <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

                <!-- Source Directory -->
                <VBox spacing="6">
                    <Label text="Source Directory" styleClass="section-label"/>
                    <HBox spacing="8">
                        <TextField fx:id="sourcePathField" HBox.hgrow="ALWAYS"
                                   promptText="Select source folder..." editable="false"/>
                        <Button text="Browse..." onAction="#onBrowseSource"/>
                    </HBox>
                </VBox>

                <!-- Target Directory -->
                <VBox spacing="6">
                    <Label text="Target Directory" styleClass="section-label"/>
                    <HBox spacing="8">
                        <TextField fx:id="targetPathField" HBox.hgrow="ALWAYS"
                                   promptText="Select target folder..." editable="false"/>
                        <Button text="Browse..." onAction="#onBrowseTarget"/>
                    </HBox>
                </VBox>

                <!-- Transfer Mode -->
                <VBox spacing="6">
                    <Label text="Transfer Mode" styleClass="section-label"/>
                    <HBox spacing="16">
                        <RadioButton fx:id="copyRadio" text="Copy (preserve originals)"
                                     onAction="#onTransferModeChanged"/>
                        <RadioButton fx:id="moveRadio" text="Move (delete originals after transfer)"
                                     onAction="#onTransferModeChanged"/>
                    </HBox>
                </VBox>

                <!-- Folder Pattern -->
                <VBox spacing="6">
                    <Label text="Folder Pattern" styleClass="section-label"/>
                    <ComboBox fx:id="folderPatternCombo" prefWidth="200"
                              onAction="#onFolderPatternChanged"/>
                </VBox>

                <!-- Duplicate Policy -->
                <VBox spacing="6">
                    <Label text="Duplicate Policy" styleClass="section-label"/>
                    <ComboBox fx:id="duplicatePolicyCombo" prefWidth="250"
                              onAction="#onDuplicatePolicyChanged"/>
                </VBox>

                <!-- Action Buttons -->
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button text="Import Job State" onAction="#onImportJobState"/>
                    <Button fx:id="startButton" text="Start Scan" styleClass="primary-button"
                            onAction="#onStartScan" disable="true"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <Label fx:id="statusLabel" text="Ready"
               style="-fx-padding: 6 16 6 16; -fx-background-color: #f0f0f0;"/>
    </bottom>
</BorderPane>
