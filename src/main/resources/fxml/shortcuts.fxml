<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      prefWidth="420" prefHeight="480" spacing="12">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <Label text="Keyboard Shortcuts" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <GridPane hgap="16" vgap="6">
        <columnConstraints>
            <ColumnConstraints minWidth="220" hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="150"/>
        </columnConstraints>

        <Label text="Action" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label text="Shortcut" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="New Scan"             GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label text="⌘N / Ctrl+N"         GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Open Job State"       GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label text="⌘O / Ctrl+O"         GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Preferences"          GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Label text="⌘, / Ctrl+,"         GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="Quit"                 GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <Label text="⌘Q / Ctrl+Q"         GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <Label text="Start Scan"           GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <Label text="⌘↵ / Ctrl+Enter"     GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        <Label text="Pause"                GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <Label text="⌘P / Ctrl+P"         GridPane.columnIndex="1" GridPane.rowIndex="6"/>
        <Label text="Resume"               GridPane.columnIndex="0" GridPane.rowIndex="7"/>
        <Label text="⌘R / Ctrl+R"         GridPane.columnIndex="1" GridPane.rowIndex="7"/>
        <Label text="Stop"                 GridPane.columnIndex="0" GridPane.rowIndex="8"/>
        <Label text="⌘. / Ctrl+."         GridPane.columnIndex="1" GridPane.rowIndex="8"/>
        <Label text="Export Job State"     GridPane.columnIndex="0" GridPane.rowIndex="9"/>
        <Label text="⌘E / Ctrl+E"         GridPane.columnIndex="1" GridPane.rowIndex="9"/>
        <Label text="Configuration screen" GridPane.columnIndex="0" GridPane.rowIndex="10"/>
        <Label text="⌘1 / Ctrl+1"         GridPane.columnIndex="1" GridPane.rowIndex="10"/>
        <Label text="Dashboard screen"     GridPane.columnIndex="0" GridPane.rowIndex="11"/>
        <Label text="⌘2 / Ctrl+2"         GridPane.columnIndex="1" GridPane.rowIndex="11"/>
        <Label text="Summary screen"       GridPane.columnIndex="0" GridPane.rowIndex="12"/>
        <Label text="⌘3 / Ctrl+3"         GridPane.columnIndex="1" GridPane.rowIndex="12"/>
        <Label text="Job History screen"   GridPane.columnIndex="0" GridPane.rowIndex="13"/>
        <Label text="⌘4 / Ctrl+4"         GridPane.columnIndex="1" GridPane.rowIndex="13"/>
        <Label text="Toggle Dark Mode"     GridPane.columnIndex="0" GridPane.rowIndex="14"/>
        <Label text="⌘D / Ctrl+D"         GridPane.columnIndex="1" GridPane.rowIndex="14"/>
        <Label text="User Guide"           GridPane.columnIndex="0" GridPane.rowIndex="15"/>
        <Label text="F1"                   GridPane.columnIndex="1" GridPane.rowIndex="15"/>
    </GridPane>
</VBox>
